# The values that differ from .env.example when the server is live. Copy the lines you need into the real .env on
# the server. Never commit the real .env.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com

# Real texts. Choose one: "semaphore" or "android". Set the key or the login yourself, on the server only.
SMS_DRIVER=semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# A login code is checked for real. This must be false or missing, or any code is accepted.
SMS_ACCEPT_ANY_CODE=false

# Push notifications through Expo, so a driver is told about a passenger while the app is closed.
PUSH_DRIVER=expo
EXPO_ACCESS_TOKEN=

# Live updates (Reverb). The key and the secret are made up by you, the app only gets the key.
BROADCAST_CONNECTION=reverb
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
LOG_LEVEL=warning
