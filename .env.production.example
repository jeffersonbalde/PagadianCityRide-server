# The values that differ from .env.example when the server is live on DigitalOcean App Platform. Put these in the
# Environment Variables of the app (mark every secret as Encrypted). Never commit the real values.

APP_NAME=PagadianCityRide
APP_ENV=production
APP_DEBUG=false
# The address that App Platform gives the app, with https and without a slash at the end.
APP_URL=https://pagadiancityride-server-xxxxx.ondigitalocean.app
# Made once on your computer with `php artisan key:generate --show`.
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The managed MySQL of DigitalOcean. Use an own database and an own user for this app, never the ones of another app.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=25060
DB_DATABASE=pagadiancityride
DB_USERNAME=
DB_PASSWORD=
# A managed database only talks over SSL.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# The photos of the driver documents and of the chats live in Spaces, because the disk of App Platform is erased at
# every deploy. Use an own bucket for this app.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sgp1
AWS_BUCKET=
AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Real texts. Choose one: "semaphore" or "android". Set the key or the login yourself, on the server only.
SMS_DRIVER=semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=PagCityRide

# The login codes and the answers to driver applications go by email while the text messages wait for the sender name.
# For the pilot: a new Gmail account that is only for the app, with 2-step verification on and an app password
# (Google Account, Security, App passwords). The app password is a secret: mark it as Encrypted.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PagadianCityRide

# A login code is checked for real. This must be false or missing, or any code is accepted.
SMS_ACCEPT_ANY_CODE=false

# Push notifications through Expo, so a driver is told about a passenger while the app is closed.
PUSH_DRIVER=expo
EXPO_ACCESS_TOKEN=

# Live updates (Reverb) are off for the first weeks: the app asks the server every few seconds instead. Leave
# EXPO_PUBLIC_REVERB_APP_KEY empty in the app too.
BROADCAST_CONNECTION=null

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
